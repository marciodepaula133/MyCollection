{
  "name": "gateway",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/gateway",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -f apps/gateway/Dockerfile -t mycollection/gateway .",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "docker run --rm --env-file .env.example mycollection/gateway nginx -t",
        "cwd": "{workspaceRoot}"
      }
    }
  },
  "tags": ["scope:gateway"]
}
