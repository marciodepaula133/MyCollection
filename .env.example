# Copy to .env and fill in real values. .env is gitignored; never commit real secrets.

# ---- gateway (AD-14) --------------------------------------------------------------------
# `|`-separated list of allowed CORS origins, e.g. http://localhost:5173|http://localhost:8080
GATEWAY_CORS_ORIGINS=http://localhost:8080

# ---- auth-db (Postgres 18) ---------------------------------------------------------------
POSTGRES_DB=auth
# Owner role: used only by auth-migrate to apply DDL (AD-12).
POSTGRES_USER=auth_owner
POSTGRES_PASSWORD=change-me-owner
# App role: DML-only grants, used by auth-api at runtime (AD-11, AD-12).
AUTH_APP_DB_USER=auth_app
AUTH_APP_DB_PASSWORD=change-me-app

# ---- auth-api ------------------------------------------------------------------------------
# App connection (DML-only role).
ConnectionStrings__Postgres=Host=auth-db;Port=5432;Database=auth;Username=auth_app;Password=change-me-app
# Owner connection, used only by the auth-migrate one-shot service (AD-12).
ConnectionStrings__PostgresMigration=Host=auth-db;Port=5432;Database=auth;Username=auth_owner;Password=change-me-owner

# JWT signing (AD-6, AD-17). Generate locally with tools/generate-dev-jwt-key.*; never commit
# the resulting .pem.
Jwt__SigningKeyPath=/run/secrets/jwt-signing-key.pem

# OAuth (AD-22). Dev redirect URIs must be registered at each provider for both the gateway
# (:8080) and the direct (:5001) hosts.
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Authentication__Discord__ClientId=
Authentication__Discord__ClientSecret=

# Where OAuth completion redirects the browser after setting the refresh cookie (AD-22).
Frontend__AuthCallbackUrl=http://localhost:8080/auth/callback

# Trusted proxy subnet for ASP.NET Forwarded Headers (AD-15) - must match the compose
# internal subnet below.
ForwardedHeaders__KnownIPNetworks=172.28.0.0/16

# ---- compose network (AD-15, AD-19) ---------------------------------------------------------
MYCOLLECTION_SUBNET=172.28.0.0/16
